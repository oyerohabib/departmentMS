{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "target": "es6",
    "rootDir": "./src",
    "sourceMap": true,
    "outDir": "dist",
    "lib": ["es2015"],
    "typeRoots": ["./src/@types", "./node_modules/@types"]
  },
  "include": ["src/**/*"]
}
